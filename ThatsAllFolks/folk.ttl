        owl:NamedIndividual ;
    rdfs:label "potential" ;
    prov:wasAttributedTo "https://scottjeffrey.com/core-values-list/" ;
    fschema:subsumedUnder bhv:Achievement .

folk:Preparedness a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "preparedness" ;
    rdfs:comment "There are certainly some things in life that you can never prepare for, but by valuing this quality, people are able to either avoid or mitigate unwelcomed circumstances. Identifying risks in any area of your life and coming up with potential plans for action is rarely something that is regretted." ;
    rdfs:subClassOf folk:Anticipation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Preparedness ) ] ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/" ;
    fschema:subsumedUnder folk:Anticipation .

folk:Productivity a inner:InnerValue,
        schw:IndividualValue,
        owl:NamedIndividual ;
    rdfs:label "productivity",
        "productivity , productiveness " ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder bhv:Achievement .

folk:Professionalism a inner:InnerValue,
        schw:IndividualValue,
        owl:NamedIndividual ;
    rdfs:label "professionalism" ;
    rdfs:comment "This isn’t just about knowing how to act professionally in the workplace. It is also about knowing how to be polite, use good manners, and be dependable in your everyday life." ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder bhv:Achievement .

folk:Prosperity a folk:FolkValue,
        owl:NamedIndividual ;
    rdfs:label "prosperity" ;
    prov:wasAttributedTo "https://themindfool.com/list-of-core-values-for-a-balanced-life/ , https://scottjeffrey.com/core-values-list/" ;
    fschema:subsumedUnder bhv:Achievement .

folk:Punctuality a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "punctuality" ;
    rdfs:comment "The thing about valuing punctuality is that it shows a great respect for other people’s time as well. This allows people to depend on you and hopefully have a mutual respect for your time as well." ;
    rdfs:subClassOf folk:Order ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Punctuality ) ] ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/" ;
    fschema:subsumedUnder folk:Order .

