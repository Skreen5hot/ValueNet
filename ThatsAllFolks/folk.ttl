folk:Partnership a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "partnership" ;
    rdfs:comment "When you value partnership, you also value collaboration, respect, teamwork, and loyalty. Whether it’s in a business or a personal setting, valuing partnership sets the stage for various ideas and opinions to come together to create something better than the sum of its parts." ;
    rdfs:subClassOf folk:Community ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Partnership ) ] ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/" ;
    fschema:subsumedUnder folk:Community .

folk:Passion a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "passion" ;
    rdfs:comment "Having enthusiasm for living your life on your own terms will ensure that you also have the determination that is needed to succeed." ;
    rdfs:subClassOf folk:Feelings ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
