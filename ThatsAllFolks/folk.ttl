folk:PeopleCannotChangeTheirSituation a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual,
        mft:NegativeValue ;
    rdfs:label "People are powerless to change their fates or personal situations" ;
    dc:date "2021-03-05T00:57:07+00:00"^^xsd:dateTime ;
    rdfs:comment "The negative value, according to which people are powerless to change their fates or personal situations." ;
    rdfs:subClassOf vcvf:NegativeValueSituation ;
