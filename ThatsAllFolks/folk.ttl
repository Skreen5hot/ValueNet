    fschema:subsumedUnder folk:Creativity .

folk:Inclusiveness a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "inclusiveness" ;
    rdfs:comment "Inclusion is a value that focuses on accepting diversity–it supports real opportunities for all people to form meaningful relationships. Just over the last two decades, people’s rights have evolved through policies and laws that require services to offer accommodations allowing everyone to participate. However, inclusion will never be fully realized until people live in line with these policies. Inclusiveness is about having positive interactions with other people and valuing everyone for who they are. That said, it has to be intrinsically motivated and derive from holding the belief that everyone has value and a right to belong." ;
    rdfs:subClassOf folk:Diversity ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Inclusiveness ) ] ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/" ;
    fschema:subsumedUnder folk:Diversity .

folk:Independence a folk:FolkValue,
        owl:NamedIndividual ;
    rdfs:label "independence" ;
    rdfs:comment "Valuing your independence doesn’t mean that you never rely on other people for anything. It simply means that you have the ability to give something meaningful back whenever you take from someone else. Independence gives you control over your own life and it makes you a creator rather than a user." ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/ , https://themindfool.com/list-of-core-values-for-a-balanced-life/ , https://scottjeffrey.com/core-values-list/" ;
    fschema:subsumedUnder folk:Freedom .

