    rdfs:label "compassion" ;
    rdfs:subClassOf folk:Feelings ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Compassion ) ] ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder folk:Feelings .

folk:Competence a inner:InnerValue,
        schw:IndividualValue,
        owl:NamedIndividual ;
    rdfs:label "competence" ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder bhv:Achievement .

folk:Compliance a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "compliance" ;
    rdfs:comment "Being compliant does not mean you’re weak. There is a lot of value in having the ability to follow directions or take the advice of a superior." ;
    rdfs:subClassOf folk:Order,
        bhv:Conservation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Compliance ) ] ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/" ;
    fschema:subsumedUnder bhv:Conservation .

folk:Composure a folk:FolkValue,
        owl:NamedIndividual ;
    rdfs:label "composure" ;
    rdfs:comment "The ability to remain calm in the face of adversity and control your emotions helps people trust you and feel like you’re a reliable and poised person." ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/" ;
    fschema:subsumedUnder folk:Self-control .

folk:Concentration a folk:FolkValue,
        owl:NamedIndividual ;
    rdfs:label "concentration" ;
    prov:wasAttributedTo "https://scottjeffrey.com/core-values-list/" ;
    fschema:subsumedUnder folk:Presence .

folk:Confidence a inner:InnerValue,
        schw:IndividualValue,
        owl:NamedIndividual ;
    rdfs:label "confidence" ;
    rdfs:comment "Being confident often helps people trust you and your decisions. When you value confidence, it suggests you also value competence. Your confidence is the sense of value that you place on yourself and the faith you have in your own capabilities. It gives you the strength to pursue what you want in life." ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder folk:Strength .

folk:Congruence a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "congruence" ;
