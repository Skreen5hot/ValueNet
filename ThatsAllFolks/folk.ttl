                    owl:oneOf ( folk:Bravery ) ] ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder folk:Courage .

folk:Brilliance a folk:FolkValue,
        owl:Class,
