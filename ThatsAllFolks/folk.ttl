            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Philanthropy ) ] ] ;
    prov:wasAttributedTo "https://themindfool.com/list-of-core-values-for-a-balanced-life/" ;
    fschema:subsumedUnder bhv:Universalism .

folk:Playfulness a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "playfulness" ;
    rdfs:comment "If you can really appreciate a good break from hard work to have a laugh, you probably value playfulness. Letting your mind relax is healthy in order to be really effective once you get back to work." ;
    rdfs:subClassOf folk:Enjoyment ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Playfulness ) ] ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder folk:Enjoyment .

