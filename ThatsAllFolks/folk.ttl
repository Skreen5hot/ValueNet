    prov:wasAttributedTo "https://scottjeffrey.com/core-values-list/" ;
    fschema:subsumedUnder folk:Enjoyment .

folk:Reflection a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual ;
