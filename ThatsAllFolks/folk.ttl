folk:Education a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "education" ;
    rdfs:comment "Aside from achieving a certification of educational accomplishment, valuing education involves the process of being a lifelong learner and continuing to gain understanding through perceptive insight. Those who value education know that it is never too late to learn–even in a formal learning environment." ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
