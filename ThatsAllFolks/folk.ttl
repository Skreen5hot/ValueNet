    fschema:subsumedUnder folk:Integrity .

folk:Accuracy a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "accuracy" ;
    rdfs:comment "Whether you’re working with data at work or in your personal life, valuing accuracy allows you to gain the necessary insight to make the best decisions. While some people and companies focus a great deal of attention on getting as much information as possible, the information gathered is not always correct, and often people gain knowledge that they don’t even know what to do with. But if you value accuracy, you will be less likely to make errors or waste time with useless information." ;
    rdfs:subClassOf folk:Order ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Accuracy ) ] ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/ , https://scottjeffrey.com/core-values-list/" ;
    fschema:subsumedUnder folk:Order .

folk:Adaptability a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
