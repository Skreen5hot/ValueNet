bhv:Tolerance a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual,
        bhv:BHV_Value ;
    rdfs:label "tolerance" ;
    rdfs:comment "Valuing tolerance goes beyond having an ability to “put up” with something. When you value tolerance, it means you have a positive view toward relationships among people who differ from each other. Tolerance can be linked to respect, equality, and independence. Valuing tolerance makes it possible for conflicting beliefs and ideas to coexist, as long as they lie within common moral values. Tolerance is a critical component in social unity and can be a remedy to prejudice." ;
    rdfs:subClassOf folk:Spirituality,
        bhv:Universalism ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( bhv:Tolerance ) ] ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/ , Schwartz92" ;
