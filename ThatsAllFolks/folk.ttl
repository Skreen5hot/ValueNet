fschema:subsumedUnder a owl:ObjectProperty,
        owl:TransitiveProperty ;
    owl:inverseOf fschema:subsumes .

fschema:subsumes a owl:ObjectProperty,
        owl:TransitiveProperty .

wn30instances:synset-value-noun-6 a owl:Class,
        owl:NamedIndividual,
        fschema:SynsetFrame ;
    rdfs:comment "an ideal accepted by some individual or group; \"he has old-fashioned values\"" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( frame:Awareness frame:Judgment frame:Regard ) ],
        fschema:FrameOccurrence ;
    fschema:subsumedUnder frame:Awareness,
        frame:Judgment,
        frame:Regard .

