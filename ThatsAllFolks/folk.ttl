:hasNegative a owl:ObjectProperty ;
    rdfs:comment "A (judgmentally, culturally dependent) opposition between a (positive) value, and a negative one. Cf. Haidt and Graham 2007, who however claim the universality of the polarity. Due to the asymmetry in the notion, the relation is not symmetric." ;
    rdfs:domain schw:IndividualValue ;
    rdfs:range mft:NegativeValue ;
    owl:inverseOf :hasPositive .

:transitivelyContrasts a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:domain schw:IndividualValue ;
    rdfs:range schw:IndividualValue ;
    owl:propertyChainAxiom ( fschema:subsumedUnder :contrasts ) .

prov:wasAttributedTo a owl:ObjectProperty .

wn30instances:synset-prize-verb-1 a owl:NamedIndividual,
        fschema:SynsetFrame ;
    rdfs:comment "hold dear; \"I prize these old photographs\"" ;
    fschema:subsumedUnder frame:Judgment .

wn30instances:synset-respect-verb-1 a owl:NamedIndividual,
        fschema:SynsetFrame ;
    rdfs:comment "regard highly; think much of; \"I respect his judgement\"; \"We prize his creativity\"" ;
    fschema:subsumedUnder frame:Judgment .

wn30instances:synset-value-noun-1 a owl:NamedIndividual,
        fschema:SynsetFrame ;
    rdfs:comment "a numerical quantity measured or assigned or computed; \"the value assigned was 16 milliseconds\"" ;
    fschema:subsumedUnder frame:Usefulness .

wn30instances:synset-value-noun-2 a owl:NamedIndividual,
        fschema:SynsetFrame ;
    rdfs:comment "the quality (positive or negative) that renders something desirable or valuable; \"the Shakespearean Shylock is of dubious value in the modern world\"" ;
    fschema:subsumedUnder frame:Differentiation .

wn30instances:synset-value-verb-1 a owl:NamedIndividual,
        fschema:SynsetFrame ;
    rdfs:comment "fix or determine the value of; assign a value to; \"value the jewelry and art work in the estate\"" ;
    fschema:subsumedUnder frame:Expertise,
        frame:Quantity .

folk:Acceptance a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "acceptance" ;
    rdfs:comment "Our world has billions of people in it–all of whom are somehow unique. Being able to accept people who are completely different from you can help increase the pleasure and enlightenment in your life." ;
    rdfs:subClassOf folk:Feelings ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Acceptance ) ] ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder folk:Feelings .

folk:Accomplishment a folk:FolkValue,
        owl:NamedIndividual ;
    rdfs:label "accomplishment" ;
    prov:wasAttributedTo "https://scottjeffrey.com/core-values-list/" ;
    fschema:subsumedUnder bhv:Achievement .

folk:Accountability a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "accountability" ;
    rdfs:subClassOf folk:Integrity ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Accountability ) ] ] ;
