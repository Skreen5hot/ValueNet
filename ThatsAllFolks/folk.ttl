                    owl:oneOf ( folk:Association ) ] ] ;
    prov:wasAttributedTo "https://themindfool.com/list-of-core-values-for-a-balanced-life/" ;
    fschema:subsumedUnder folk:Community .

folk:Attentiveness a inner:InnerValue,
        schw:IndividualValue,
        owl:NamedIndividual ;
    rdfs:label "attentiveness",
        "attentiveness , attentive " ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder folk:Presence .

folk:Authenticity a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "authenticity" ;
    rdfs:comment "Not valuing authenticity, especially when it comes to your own actions, can result in anxiety, frustration, depression, and a loss of meaning in your life. Many people present themselves in a way they believe is the most socially acceptable or in a way that they think other people want them to present themselves." ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Authenticity ) ] ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/ , https://themindfool.com/list-of-core-values-for-a-balanced-life/ , https://benjaminspall.com/core-values/" .

