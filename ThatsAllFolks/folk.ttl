folk:Alertness a folk:FolkValue,
        owl:NamedIndividual ;
    rdfs:label "alertness" ;
    prov:wasAttributedTo "https://scottjeffrey.com/core-values-list/" ;
    fschema:subsumedUnder folk:Presence .

folk:Altruism a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "altruism" ;
    rdfs:comment "Those who value altruism have an unselfish concern for other people. They perform random acts of kindness on a regular basis and do things to help others for the sole reason of benefitting someone else in some way. Valuing altruism means you don’t feel obligated to do anything for others due to having a sense of loyalty or even for religious reasons. If you make it a priority to do selfless acts, you value altruism." ;
    rdfs:subClassOf folk:Spirituality ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Altruism ) ] ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder folk:Spirituality .

