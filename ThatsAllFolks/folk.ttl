folk:Unity a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "unity" ;
    rdfs:comment "The value of unity is that everyone on a team or in a group setting is respected. Unity breeds cooperation, increases people’s enthusiasm, and furnishes an empowering atmosphere. When you value unity, you believe in fostering a sense of belonging and improving everyone’s wellbeing." ;
    rdfs:subClassOf folk:Spirituality ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
