schw:CulturalValue a owl:Class ;
    rdfs:label "cultural value" ;
    rdfs:comment """Cultural values represent ideals that shape the beliefs and actions of individuals and groups in the culture. They act as societal responses to three main challenges to a successful cohabitation: relations between individuals and groups (contrasting Intellectual/Affective Autonomy vs. Embeddedness); the way individuals act in a responsible manner toward preserving the well-being of their society (contrasting Egalitarianism vs. Hierarchy); individuals’ interests regarding the natural and social environment (contrasting Harmony vs. Mastery) (Schwartz2006).

In contrast to individual values, which are observable constructs affecting individual behavior, cultural values are abstract constructs (Schwartz2014), which manifest in various forms ranging from written artifacts to knowledge that members of the culture communicate amongst each other.

Methodological discussion in: Erich H. Witte, Adrian Stanciu and Klaus Boehnke. A New Empirical Approach to Intercultural Comparisons of Value Preferences Based on Schwartz’s Theory. Front. Psychol., 14 July 2020, 10.3389/fpsyg.2020.01723""" ;
    rdfs:subClassOf bhv:BHV_Value .

bhv:SelfEnhancement a schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual,
        bhv:BHV_Value ;
    rdfs:label "self-enhancement" ;
    :contrasts bhv:SelfTranscendence ;
    rdfs:comment "“The second dimension contrasts ‘self-enhancement’ and ‘self-transcendence’ values. This dimension captures the conflict between values that emphasize concern for the welfare and interests of others (universalism, benevolence) and values that emphasize pursuit of one’s own interests and relative success and dominance over others (power, achievement).”" ;
    rdfs:subClassOf folk:Personal_focus ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( bhv:SelfEnhancement ) ] ] ;
    prov:wasAttributedTo "Schwartz92" ;
    fschema:subsumedUnder folk:Evolution,
        folk:Personal_focus .

folk:Courage a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "courage" ;
    rdfs:comment "As one of the principal characteristics of leadership, courage guarantees a lot of other great qualities in a leader. Courage demonstrates confidence and a willingness to use your voice to influence others. Courage is an important value to have because it defines your decision to act according to your values and work toward your goals instead of letting yourself be distracted or allured by irrelevant and potentially harmful temptations." ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Courage ) ] ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" .

folk:Freedom a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual,
        bhv:BHV_Value ;
    rdfs:label "freedom" ;
    rdfs:comment "This is a value that most people hold close to their hearts–and it doesn’t only involve valuing your own freedom–it also encompasses advocating from freedom if you ever see an opportunity to do so." ;
    rdfs:subClassOf bhv:SelfDirection ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Freedom ) ] ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/ , Schwartz92" ;
    fschema:subsumedUnder bhv:SelfDirection .

folk:Health a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "health" ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Health ) ] ] ;
    prov:wasAttributedTo "https://themindfool.com/list-of-core-values-for-a-balanced-life/ , https://scottjeffrey.com/core-values-list/ , https://benjaminspall.com/core-values/" .

folk:Personal_focus a schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "personal focus" ;
    :contrasts folk:Social_focus ;
    rdfs:comment "Individual values are responses to three universal requirements: biological needs, agreement on social actions, survival and well-being of groups (Schwartz1992).",
        """Individual values are subjective beliefs of individuals (a) associated with affect, (b) referring to goals that motivate action, (c) transcending specific situations, (d) serving as evaluative standards, (e) ordered according to their relative (our emphasis) importance, and (f) guiding individuals’ action
(Schwartz2102).""" ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Personal_focus ) ] ] .

folk:Social_focus a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "social focus" ;
    dc:date "2021-03-04T10:30:13+00:00"^^xsd:dateTime ;
    :contrasts folk:Personal_focus ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Social_focus ) ] ] .

fschema:ConceptualFrame a owl:Class ;
    rdfs:subClassOf dul:Description .

bhv:Security a schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual,
        bhv:BHV_Value ;
    rdfs:label "security" ;
    rdfs:comment "Defining goal: safety, harmony, and stability of society, of relationships, and of self.",
        "People want to minimize their risk of being a victim of any type of security threat, which makes this a common value." ;
    rdfs:subClassOf folk:Order,
        bhv:Conservation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( bhv:Security ) ] ] ;
    prov:wasAttributedTo "Schwartz92" ;
    fschema:subsumedUnder bhv:Conservation .

fschema:FrameOccurrence a owl:Class ;
    rdfs:subClassOf dul:Situation .

bhv:Power a schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual,
        bhv:BHV_Value ;
    rdfs:label "power" ;
    rdfs:comment "Defining goal: social status and prestige, control or dominance over people and resources." ;
    rdfs:subClassOf folk:Self-protection,
        folk:Strength,
        bhv:Anxiety-avoidance,
        bhv:SelfEnhancement ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( bhv:Power ) ] ] ;
    prov:wasAttributedTo "Schwartz92" ;
    fschema:subsumedUnder folk:Self-protection,
        bhv:Anxiety-avoidance .

vcvf:NegativeValueSituation a owl:Class ;
    rdfs:label "negative value situation" ;
    rdfs:subClassOf fschema:FrameOccurrence ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom mft:NegativeValue ] .

bhv:Conformity a schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual,
        bhv:BHV_Value ;
    rdfs:label "conformity" ;
    rdfs:comment "Defining goal: restraint of actions, inclinations, and impulses likely to upset or harm others and violate social expectations or norms." ;
    rdfs:subClassOf folk:Social_focus,
        bhv:Conservation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( bhv:Conformity ) ] ] ;
    prov:wasAttributedTo "Schwartz92" ;
    fschema:subsumedUnder folk:Social_focus,
        bhv:Conservation .

mft:MFT_Value a owl:Class ;
    rdfs:subClassOf vcvf:Value .

bhv:OpennessToChange a schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual,
        bhv:BHV_Value ;
    rdfs:label "openness to change" ;
    :contrasts bhv:Conservation ;
    rdfs:comment "This dimension captures the conflict between values that emphasize independence of thought, action, and feelings and readiness for change (self-direction, stimulation) and values that emphasize order, self-restriction, preservation of the past, and resistance to change (security, conformity, tradition).”" ;
    rdfs:subClassOf folk:Personal_focus,
        :Growth,
        bhv:Anxiety-free ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( bhv:OpennessToChange ) ] ] ;
    prov:wasAttributedTo "Schwartz92" ;
    fschema:subsumedUnder folk:Personal_focus,
        bhv:Anxiety-free .

bhv:Universalism a schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual,
        bhv:BHV_Value ;
    rdfs:label "universalism" ;
    rdfs:comment "Defining goal: understanding, appreciation, tolerance, and protection for the welfare of all people and for nature." ;
    rdfs:subClassOf bhv:SelfTranscendence ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( bhv:Universalism ) ] ] ;
    prov:wasAttributedTo "Schwartz92" ;
    fschema:subsumedUnder bhv:SelfTranscendence .

mft:NegativeValue a owl:Class ;
    rdfs:label "negative value" ;
    rdfs:comment "A value that is considered negative to those that commit to it (used for Haidt oppositions)." ;
    rdfs:subClassOf fschema:ConceptualFrame .

bhv:Benevolence a schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual,
        bhv:BHV_Value ;
    rdfs:label "benevolence" ;
    rdfs:comment "Defining goal: preserving and enhancing the welfare of those with whom one is in frequent personal contact (the ‘in-group’)." ;
    rdfs:subClassOf bhv:SelfTranscendence ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( bhv:Benevolence ) ] ] ;
    prov:wasAttributedTo "Schwartz92" ;
    fschema:subsumedUnder bhv:SelfTranscendence .

bhv:SelfTranscendence a schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual,
        bhv:BHV_Value ;
    rdfs:label "self-transcendence" ;
    rdfs:comment "“The second dimension contrasts ‘self-enhancement’ and ‘self-transcendence’ values. This dimension captures the conflict between values that emphasize concern for the welfare and interests of others (universalism, benevolence) and values that emphasize pursuit of one’s own interests and relative success and dominance over others (power, achievement).”" ;
    rdfs:subClassOf folk:Social_focus,
        :Growth,
        bhv:Anxiety-free ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( bhv:SelfTranscendence ) ] ] ;
    prov:wasAttributedTo "Schwartz92" ;
    fschema:subsumedUnder folk:Social_focus,
        bhv:Anxiety-free .

folk:Community a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "community" ;
    rdfs:comment "Valuing community means striving to create a sense of belongingness in your surroundings and being willing to give back to places that have contributed to who you are today." ;
    rdfs:subClassOf folk:Spirituality ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Community ) ] ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/ , https://themindfool.com/list-of-core-values-for-a-balanced-life/ , https://scottjeffrey.com/core-values-list/" ;
    fschema:subsumedUnder folk:Spirituality .

folk:Enjoyment a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "enjoyment" ;
    rdfs:subClassOf folk:Feelings ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Enjoyment ) ] ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder folk:Feelings .

bhv:Conservation a schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual,
        bhv:BHV_Value ;
    rdfs:label "conservation" ;
    rdfs:comment "This dimension captures the conflict between values that emphasize independence of thought, action, and feelings and readiness for change (self-direction, stimulation) and values that emphasize order, self-restriction, preservation of the past, and resistance to change (security, conformity, tradition).”",
        "Wanting to conserve what you currently have and not constantly seeking more resources to consume is an important value to have. When you value conservation, there is a good chance that you are satisfied with the things you have and content in your life." ;
    rdfs:subClassOf folk:Self-protection,
        bhv:Anxiety-avoidance ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( bhv:Conservation ) ] ] ;
    prov:wasAttributedTo "Schwartz92" ;
    fschema:subsumedUnder folk:Self-protection,
        bhv:Anxiety-avoidance .

folk:Integrity a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "integrity" ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Integrity ) ] ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" .

folk:Creativity a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual,
        bhv:BHV_Value ;
    rdfs:label "creativity",
        "creativity , creativeness , creation" ;
    rdfs:comment "If you value creativity, you enjoy using your imagination to solve problems or generate new ideas. Valuing creativity supports your ability to make a change in society that other people find significant." ;
    rdfs:subClassOf vcvf:ValueSituation,
        bhv:SelfDirection ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Creativity ) ] ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/ , Schwartz92" ;
    fschema:subsumedUnder bhv:SelfDirection .

folk:Presence a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "presence , present" ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Presence ) ] ] ;
    prov:wasAttributedTo "https://themindfool.com/list-of-core-values-for-a-balanced-life/ , https://scottjeffrey.com/core-values-list/" .

folk:Strength a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "strength" ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Strength ) ] ] ;
    prov:wasAttributedTo "https://scottjeffrey.com/core-values-list/" .

folk:Intelligence a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "intelligence" ;
    rdfs:comment "Valuing intelligence isn’t just acknowledging your natural born ability to understand concepts. It involves constantly yearning to learn more." ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Intelligence ) ] ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/ , https://scottjeffrey.com/core-values-list/" .

folk:Order a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "order",
        "order , orderliness" ;
    rdfs:comment "Many people have a hard time making any personal progress if they’re living in a chaotic environment. Cleanliness and orderliness are often values people hold to maintain a calm state of mind." ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Order ) ] ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" .

folk:Feelings a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "feelings" ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Feelings ) ] ] ;
    prov:wasAttributedTo "https://scottjeffrey.com/core-values-list/" .

vcvf:ValueSituation a owl:Class ;
    rdfs:label "value situation" ;
    rdfs:comment "Any situation satisfying a Value description, e.g. a social fact, deliberation, legal decision, opinion, story, etc. that is informed by, or depends on, values such as Tolerance, Concern, Power, Security, etc." ;
    rdfs:subClassOf fschema:FrameOccurrence ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom vcvf:Value ],
        wn30instances:synset-value-noun-6 .

folk:Spirituality a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "spirituality" ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Spirituality ) ] ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" .

bhv:BHV_Value a owl:Class ;
    rdfs:subClassOf vcvf:Value .

bhv:Achievement a schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual,
        bhv:BHV_Value ;
    rdfs:label "achievement" ;
    rdfs:comment "Accomplishing something in your life or work that is noteworthy could be something that adds a unique sense of value to your life. Your achievement values impact your motivation because your incentive to work outweighs the cost of doing so.",
        "Defining goal: personal success through demonstrating competence according to social standards." ;
    rdfs:subClassOf bhv:SelfEnhancement ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( bhv:Achievement ) ] ] ;
    prov:wasAttributedTo "Schwartz92" ;
    fschema:subsumedUnder bhv:SelfEnhancement .

inner:InnerValue a owl:Class ;
    rdfs:subClassOf vcvf:Value .

folk:FolkValue a owl:Class ;
    rdfs:subClassOf vcvf:Value .

schw:IndividualValue a owl:Class ;
    rdfs:label "individual value" ;
    rdfs:comment "Actions pursuing one value “have consequences that conflict with some values but are congruent with others.” This has “practical, psychological, and social consequences.” “Of course, people can and do pursue competing values, but not in a single act. Rather, they do so through different acts, at different times, and in different settings.”",
        "Individual values are responses to three universal requirements: biological needs, agreement on social actions, survival and well-being of groups (Schwartz1992).",
        """Individual values are subjective beliefs of individuals (a) associated with affect, (b) referring to goals that motivate action, (c) transcending specific situations, (d) serving as evaluative standards, (e) ordered according to their relative (our emphasis) importance, and (f) guiding individuals’ action
(Schwartz2012).""" ;
    rdfs:subClassOf bhv:BHV_Value .

dul:satisfies a owl:ObjectProperty ;
    rdfs:domain dul:Situation ;
    rdfs:range dul:Description .

folk:Religion a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "religion" ;
    rdfs:comment "Valuing religion refers to holding a system of religious belief and practice as a guide to living. It sits under Beliefs alongside Faith and Belief in God, and is the value evoked by religious vocabulary: religion itself, its negations and variants, and the roles and places of religious practice." ;
    rdfs:subClassOf folk:Beliefs ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Religion ) ] ] ;
    prov:wasAttributedTo "ValueNet modelling decision, BFO/vcvf-triggers-review.md ; derived from the religion lexicon of ThatsAllFolks/folk_Religion.ttl" ;
    fschema:subsumedUnder folk:Beliefs .

folk:Involvement a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "involvement" ;
    rdfs:comment "Valuing involvement refers to taking an active part in something rather than remaining apart from it. Evoked by the involvement lexicon and its variants: involvement, noninvolvement, overinvolvement, reinvolvement." ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Involvement ) ] ] ;
    prov:wasAttributedTo "ValueNet modelling decision, BFO/vcvf-triggers-review.md ; derived from the lexicon of ThatsAllFolks/folk_Involvement.ttl" .
