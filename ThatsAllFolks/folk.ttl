folk:Approachability a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "approachability",
        "approachability , attainability , attainable" ;
    rdfs:comment "People who hold a personal core value of being approachable want others to feel free to come to them with problems. People who want to be approachable often easily gain the trust of other people." ;
    rdfs:subClassOf bhv:SelfTranscendence ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Approachability ) ] ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/ , https://themindfool.com/list-of-core-values-for-a-balanced-life/" ;
    fschema:subsumedUnder bhv:SelfTranscendence .

folk:Assertion a folk:FolkValue,
        owl:NamedIndividual ;
    rdfs:label "assertion",
        "assertion , assertiveness" ;
    rdfs:comment "Those who value being assertive know what they want, act quickly to obtain it, and do what they have to do to be successful." ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/ , https://scottjeffrey.com/core-values-list/" ;
    fschema:subsumedUnder folk:Strength .

folk:Association a folk:FolkValue,
