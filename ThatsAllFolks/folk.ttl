    rdfs:label "adaptability" ;
    rdfs:subClassOf folk:Spirituality ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Adaptability ) ] ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder folk:Spirituality .

folk:Adventure a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "adventure",
        "adventure , adventurous" ;
    rdfs:comment "Those who value adventure lead rich and exciting lives by seeking out new experiences to expand their skills and existence." ;
    rdfs:subClassOf bhv:OpennessToChange,
        bhv:Stimulation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Adventure ) ] ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/ , https://themindfool.com/list-of-core-values-for-a-balanced-life/" ;
    fschema:subsumedUnder bhv:OpennessToChange .

folk:Affective_autonomy a schw:CulturalValue,
        owl:Class,
        owl:NamedIndividual,
        bhv:BHV_Value ;
    rdfs:label "affective autonomy" ;
    :contrasts folk:Embeddedness ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
