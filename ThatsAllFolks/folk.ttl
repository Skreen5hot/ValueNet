    prov:wasAttributedTo "https://themindfool.com/list-of-core-values-for-a-balanced-life/" .

folk:Recognition a folk:FolkValue,
        owl:NamedIndividual ;
    rdfs:label "recognition" ;
    rdfs:comment "Valuing recognition of your work means that you know its importance and you want other people to see that as well. You want confirmation of its importance to the world. This doesn’t mean that you always feel like you need to be praised, it’s simply a value that means you feel a sense of satisfaction when you’re reassured that you’re adding value to some sort of domain. Being recognized for your work helps you stay motivated to maintain–or even improve–your performance." ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/ , https://scottjeffrey.com/core-values-list/" ;
    fschema:subsumedUnder bhv:Achievement .

folk:Recreation a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
