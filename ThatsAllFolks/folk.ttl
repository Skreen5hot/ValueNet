bhv:Nature a schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual,
        bhv:BHV_Value ;
    rdfs:label "environmental sustainability , environmentalism, protecting the environment, nature (Schwartz)" ;
    rdfs:comment "Both individuals and companies are becoming increasingly concerned about environmental sustainability to protect the earth for future generations in addition to our own. According to the EPA, air pollution can increase one’s risk of suffering from health issues such as heart attacks, lung disease, and premature mortality. Further, the CDC has reported that the pollution in water can increase one’s risks of developing gastrointestinal illnesses, reproductive issues, and neurological disorders. Considering that the environment can be harming us if it’s not properly cared for has made environmental sustainability a common value among people." ;
    rdfs:subClassOf bhv:Universalism ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( bhv:Nature ) ] ] ;
    prov:wasAttributedTo "Schwartz92" ;
    fschema:subsumedUnder bhv:Universalism .

