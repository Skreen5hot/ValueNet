folk:Collaboration a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "collaboration" ;
    rdfs:comment "Working together by sharing your ideas with others can result in accomplishing something great. Collaborating with others will often lead to something that is greater than the sum of its parts." ;
    rdfs:subClassOf folk:Community ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Collaboration ) ] ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/" ;
    fschema:subsumedUnder folk:Community .

folk:Comfort a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "comfort" ;
    rdfs:subClassOf folk:Feelings ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Comfort ) ] ] ;
    prov:wasAttributedTo "https://scottjeffrey.com/core-values-list/" ;
    fschema:subsumedUnder folk:Feelings .

folk:Commitment a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "commitment" ;
    rdfs:comment "People commit to things that they believe in–whether that’s a relationship, a new opportunity, or anything else that seems truly promising. Those who value commitment are good at managing both personal and professional relationships, especially when it comes to handling conflicts, building a sense of trust, collaborating with others, and working well on a team. When commitment is on your list of values, you likely also have:A strong work ethic; Feelings of accountability; Passion; Discipline." ;
    rdfs:subClassOf folk:Integrity ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Commitment ) ] ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder folk:Integrity .

folk:Common_sense a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "common sense" ;
    rdfs:subClassOf folk:Intelligence ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Common_sense ) ] ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder folk:Intelligence .

folk:Communication a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "communication" ;
    rdfs:comment "Valuing communication involves not only having information relayed properly to you, but also ensuring that your own thoughts are effectively heard by other people." ;
    rdfs:subClassOf folk:Spirituality ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
