folk:Bravery a inner:InnerValue,
        schw:IndividualValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "bravery" ;
    rdfs:comment "When one of your personal core values is bravery, it means that you always do the right thing, even if you’re the only person making the tough decision." ;
    rdfs:subClassOf folk:Courage ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
