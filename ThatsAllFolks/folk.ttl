folk:Novelty a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "novelty" ;
    rdfs:comment "Some value the pursuit of new challenges, circumstances, and experiences in life. If you live in the same town where you were born and tend to stick to a routine, novelty is likely not one of your personal core values." ;
    rdfs:subClassOf bhv:OpennessToChange ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Novelty ) ] ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/" ;
    fschema:subsumedUnder bhv:OpennessToChange .

folk:Objectivity a folk:FolkValue,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "objectivity" ;
    rdfs:comment "It is helpful to value objectivity in the workplace because it means you’re willing to look at the facts when you’re confronted with a conflict. You’re able to put your emotions and personal involvement aside." ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( folk:Objectivity ) ] ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/" .

