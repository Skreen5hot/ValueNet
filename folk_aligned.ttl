folk:Risk
    rdf:type folk:FolkValue ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "If you value taking risks, you know that if you follow your gut, there is a chance that it will lead to a huge payoff. You’re not afraid to face the option of failing if there is also an option for success." ;
    rdfs:label "risk" ;
    rdfs:label "risk , risk-Taking" ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/ , https://scottjeffrey.com/core-values-list/" ;
    fschema:subsumedUnder bhv:Achievement .

