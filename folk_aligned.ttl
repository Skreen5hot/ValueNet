        owl:onProperty dul:satisfies ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf [
                rdf:first folk:Reliability ;
                rdf:rest rdf:nil
            ]
        ]
    ] ;
    fschema:subsumedUnder folk:Trust .

folk:Religion
    rdf:type folk:FolkValue ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "Valuing religion refers to holding a system of religious belief and practice as a guide to living. It sits under Beliefs alongside Faith and Belief in God, and is the value evoked by religious vocabulary: religion itself, its negations and variants, and the roles and places of religious practice." ;
    rdfs:label "religion" ;
    rdfs:subClassOf folk:Beliefs ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty dul:satisfies ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf [
                rdf:first folk:Religion ;
                rdf:rest rdf:nil
            ]
        ]
    ] ;
    prov:wasAttributedTo "ValueNet modelling decision, BFO/vcvf-triggers-review.md ; derived from the religion lexicon of ThatsAllFolks/folk_Religion.ttl" ;
    fschema:subsumedUnder folk:Beliefs .

folk:Resilience
    rdf:type folk:FolkValue ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "How easy is it for you to cope with adversity? If you value resilience, you strive to be flexible, go with the flow, and bounce back after things don’t go your way." ;
    rdfs:label "resilience" ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty dul:satisfies ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf [
                rdf:first folk:Resilience ;
                rdf:rest rdf:nil
            ]
        ]
    ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/ , https://themindfool.com/list-of-core-values-for-a-balanced-life/" .

folk:Respect
    rdf:type folk:FolkValue ;
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/inner.owl#InnerValue> ;
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/schwartz.owl#IndividualValue> ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "Giving and receiving respect is important because it fosters a sense of connection between people and it makes us feel comfortable expressing ourselves to others. Valuing respect means you’re able to accept other people, despite their difference in background or beliefs from your own. Having respect helps build feelings of trust, security, and safety." ;
    rdfs:label "respect" ;
    rdfs:label "respect , respectfulness , respect for others" ;
    rdfs:subClassOf folk:Feelings ;
    rdfs:subClassOf bhv:Conformity ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty dul:satisfies ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf [
                rdf:first folk:Respect ;
                rdf:rest rdf:nil
            ]
        ]
    ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/ , Schwartz92" ;
    fschema:subsumedUnder bhv:Conformity .

folk:Respect_for_self
    rdf:type folk:FolkValue ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:label "respect for self" ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty dul:satisfies ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
