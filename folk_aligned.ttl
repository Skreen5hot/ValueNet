    fschema:subsumedUnder bhv:SelfTranscendence .

folk:Assertion
    rdf:type folk:FolkValue ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "Those who value being assertive know what they want, act quickly to obtain it, and do what they have to do to be successful." ;
    rdfs:label "assertion" ;
    rdfs:label "assertion , assertiveness" ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/ , https://scottjeffrey.com/core-values-list/" ;
    fschema:subsumedUnder folk:Strength .

