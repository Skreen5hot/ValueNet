    rdf:type bhv:BHV_Value ;
    rdfs:comment "Defining goal: safety, harmony, and stability of society, of relationships, and of self." ;
    rdfs:comment "People want to minimize their risk of being a victim of any type of security threat, which makes this a common value." ;
    rdfs:label "security" ;
    rdfs:subClassOf folk:Order ;
    rdfs:subClassOf bhv:Conservation ;
    owl:equivalentClass [
