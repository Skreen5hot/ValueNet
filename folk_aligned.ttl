bhv:SelfEnhancement
    <http://www.ontologydesignpatterns.org/ont/values/valuemerge_rev.owl#contrasts> bhv:SelfTranscendence ;
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/schwartz.owl#IndividualValue> ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdf:type bhv:BHV_Value ;
    rdfs:comment "“The second dimension contrasts ‘self-enhancement’ and ‘self-transcendence’ values. This dimension captures the conflict between values that emphasize concern for the welfare and interests of others (universalism, benevolence) and values that emphasize pursuit of one’s own interests and relative success and dominance over others (power, achievement).”" ;
    rdfs:label "self-enhancement" ;
    rdfs:subClassOf folk:Personal_focus ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty dul:satisfies ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf [
                rdf:first bhv:SelfEnhancement ;
                rdf:rest rdf:nil
            ]
        ]
    ] ;
    prov:wasAttributedTo "Schwartz92" ;
    fschema:subsumedUnder folk:Evolution ;
    fschema:subsumedUnder folk:Personal_focus .

