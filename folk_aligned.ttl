    fschema:subsumedUnder folk:Creativity .

folk:OtherPeopleCannotBeTrusted
    <http://purl.org/dc/elements/1.1/date> "2021-03-05T00:59:05+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    rdf:type folk:FolkValue ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdf:type mft:NegativeValue ;
    rdfs:comment "The negative value, according to which other people are fundamentally untrustworthy and unloving." ;
    rdfs:label "Other people are fundamentally untrustworthy and unloving" ;
    rdfs:subClassOf vcvf:NegativeValueSituation ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
