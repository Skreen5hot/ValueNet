folk:Simplicity
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/inner.owl#InnerValue> ;
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/schwartz.owl#IndividualValue> ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "People tend to make things more complicated than they need to be. Those who prefer to keep things straightforward are those who value simplicity." ;
    rdfs:label "simplicity" ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder folk:Presence .

folk:Sincerity
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/inner.owl#InnerValue> ;
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/schwartz.owl#IndividualValue> ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "This can go hand-in-hand with honesty, but it also involves being authentic in everything you say and avoiding putting on any type of front to impress other people." ;
    rdfs:label "sincerity" ;
    rdfs:subClassOf folk:Integrity ;
    owl:equivalentClass [
