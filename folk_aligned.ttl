folk:Humor
    rdf:type folk:FolkValue ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "This should not be overlooked when it comes to values, as humor can make a big difference in lightening the load of a difficult situation. When used appropriately, humor can be an effective tool." ;
    rdfs:label "humor" ;
    rdfs:label "humor , good humor , humorous attitude" ;
