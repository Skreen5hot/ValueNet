folk:Preparedness
    rdf:type folk:FolkValue ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "There are certainly some things in life that you can never prepare for, but by valuing this quality, people are able to either avoid or mitigate unwelcomed circumstances. Identifying risks in any area of your life and coming up with potential plans for action is rarely something that is regretted." ;
    rdfs:label "preparedness" ;
    rdfs:subClassOf folk:Anticipation ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
