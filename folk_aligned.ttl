    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "Some value the pursuit of new challenges, circumstances, and experiences in life. If you live in the same town where you were born and tend to stick to a routine, novelty is likely not one of your personal core values." ;
    rdfs:label "novelty" ;
    rdfs:subClassOf bhv:OpennessToChange ;
