    fschema:subsumedUnder folk:Enjoyment .

folk:Imagination
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/inner.owl#InnerValue> ;
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/schwartz.owl#IndividualValue> ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "Valuing imagination can be a huge advantage to anyone in our fast-paced society. Being able to come up with an idea that no one else has thought of before can be a huge part of being successful." ;
    rdfs:label "imagination" ;
    rdfs:label "imagination , imaginative" ;
    rdfs:subClassOf folk:Creativity ;
