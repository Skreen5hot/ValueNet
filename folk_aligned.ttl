folk:Willingness
    rdf:type folk:FolkValue ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "Valuing readiness to act or consent when asked. Evoked by the willing lexicon: willing, unwilling, willingly, overwilling, well-willing. Distinct from folk:Will, which sits under folk:Strength and reads as willpower rather than readiness." ;
    rdfs:label "willingness" ;
