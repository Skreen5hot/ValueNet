folk:Self-awareness
    rdf:type folk:FolkValue ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "This is a very important core value to have, as it lets you realize when you’ve messed up and pinpoint how you can fix your mistakes in the future. Having self-awareness also means you know why you react to certain situations in the way that you do and recognize triggers that may lead to certain emotions." ;
    rdfs:label "self-awareness" ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty dul:satisfies ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf [
                rdf:first folk:Self-awareness ;
                rdf:rest rdf:nil
            ]
        ]
    ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/ , https://themindfool.com/list-of-core-values-for-a-balanced-life/" .

folk:Self-confidence
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/inner.owl#InnerValue> ;
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/schwartz.owl#IndividualValue> ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "Having this value involves being successful in such a way that you recognize your skills are making a positive contribution to your community or those around you." ;
    rdfs:label "self-confidence" ;
    rdfs:label "self-confidence , self-reliance" ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder folk:Strength .

