                rdf:rest rdf:nil
            ]
        ]
    ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/" ;
    fschema:subsumedUnder folk:Community .

folk:Passion
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/inner.owl#InnerValue> ;
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/schwartz.owl#IndividualValue> ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "Having enthusiasm for living your life on your own terms will ensure that you also have the determination that is needed to succeed." ;
    rdfs:label "passion" ;
    rdfs:subClassOf folk:Feelings ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty dul:satisfies ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf [
                rdf:first folk:Passion ;
                rdf:rest rdf:nil
            ]
        ]
    ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder folk:Feelings .

folk:Patience
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/inner.owl#InnerValue> ;
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/schwartz.owl#IndividualValue> ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "Valuing patience means recognizing the fact that sometimes the only thing that can make something work out in your favor is time." ;
    rdfs:label "patience" ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty dul:satisfies ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf [
                rdf:first folk:Patience ;
                rdf:rest rdf:nil
            ]
        ]
    ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" .

folk:Patriotism
    rdf:type folk:FolkValue ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "It’s about learning from our past mistakes and being vigilant about considering if the country is headed in the right direction. Patriotism is a spirit of camaraderie for others who live in this country, regardless of their background. Valuing patriotism is about knowing when the country is fumbling, and doing your part to make it a better place." ;
    rdfs:label "patriotism" ;
    rdfs:subClassOf bhv:Conservation ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty dul:satisfies ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf [
                rdf:first folk:Patriotism ;
                rdf:rest rdf:nil
            ]
        ]
    ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/ , https://themindfool.com/list-of-core-values-for-a-balanced-life/" ;
    fschema:subsumedUnder bhv:Conservation .

