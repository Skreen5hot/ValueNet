folk:Balance
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/inner.owl#InnerValue> ;
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/schwartz.owl#IndividualValue> ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "If one of your personal core values is balance, you prevent any one thing from taking over your life. Between your career, family, friends, and hobbies, you make sure to keep your own personal enjoyment in mind and you level out your stress with relaxation." ;
    rdfs:label "balance" ;
    rdfs:subClassOf folk:Spirituality ;
