        rdf:type owl:Restriction ;
        owl:onProperty dul:satisfies ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf [
                rdf:first folk:Balance ;
                rdf:rest rdf:nil
            ]
        ]
    ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder folk:Spirituality .

