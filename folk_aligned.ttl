    rdf:type mft:NegativeValue ;
    rdfs:comment "The negative value situation of being in poor health. Evoked by the FrameNet MedicalConditions frame and the ailment, illness and injury vocabulary aligned to it. Distinct from folk:Health, which is the corresponding positive value." ;
    rdfs:label "bad health" ;
