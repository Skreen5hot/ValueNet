folk:Honesty
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/inner.owl#InnerValue> ;
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/schwartz.owl#IndividualValue> ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "It is very difficult to repair a bad reputation, especially if it is one that suggests you cannot be trusted. Telling the truth and sticking to your word are both critical in the long run, which makes diligently protecting your reputation an important value." ;
    rdfs:label "honesty" ;
    rdfs:subClassOf folk:Integrity ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
