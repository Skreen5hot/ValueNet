folk:PeopleCannotChangeTheirSituation
    <http://purl.org/dc/elements/1.1/date> "2021-03-05T00:57:07+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    rdf:type folk:FolkValue ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdf:type mft:NegativeValue ;
