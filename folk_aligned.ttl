folk:Playfulness
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/inner.owl#InnerValue> ;
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/schwartz.owl#IndividualValue> ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "If you can really appreciate a good break from hard work to have a laugh, you probably value playfulness. Letting your mind relax is healthy in order to be really effective once you get back to work." ;
    rdfs:label "playfulness" ;
    rdfs:subClassOf folk:Enjoyment ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
