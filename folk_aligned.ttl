folk:Originality
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/inner.owl#InnerValue> ;
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/schwartz.owl#IndividualValue> ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "Valuing originality means that you walk your own path and stray away from what everyone else seems to be doing. This value comes naturally and can usually be seen through art or creativity." ;
