    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "Our society loves “things”. We love extra features, “all-in-one” products, and things of the sort–and we also love saving money. Putting those two things together undoubtedly makes versatility a common value among people. Recycling and repurposing are popular ways in which people act on their value of versatility, as reusing older products to make something “new” or completely starting from scratch with used materials are both environmentally sustainable practices, which are also valued among people." ;
    rdfs:label "versatility" ;
    rdfs:subClassOf vcvf:ValueSituation ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty dul:satisfies ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf [
                rdf:first folk:Versatility ;
                rdf:rest rdf:nil
            ]
        ]
    ] ;
    prov:wasAttributedTo "https://www.developgoodhabits.com/core-values/" .

