folk:Punctuality
    rdf:type folk:FolkValue ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "The thing about valuing punctuality is that it shows a great respect for other people’s time as well. This allows people to depend on you and hopefully have a mutual respect for your time as well." ;
    rdfs:label "punctuality" ;
    rdfs:subClassOf folk:Order ;
