folk:Fairness
    <http://www.ontologydesignpatterns.org/ont/values/valuemerge_rev.owl#hasNegative> mft:Cheating ;
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/inner.owl#InnerValue> ;
