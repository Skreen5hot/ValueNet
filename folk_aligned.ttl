folk:Inner_peace
    rdf:type folk:FolkValue ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "This personal core value refers to the ability to be comfortable with yourself, the people around you, and being accepting of the life you’re living." ;
