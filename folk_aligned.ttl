dul:Description
    rdf:type owl:Class .

dul:Situation
    rdf:type owl:Class .

dul:satisfiedBy
    rdf:type owl:ObjectProperty ;
    owl:inverseOf dul:satisfies .

dul:satisfies
    rdf:type owl:ObjectProperty ;
    rdfs:domain dul:Situation ;
    rdfs:range dul:Description .

folk::Accomplishment
    rdf:type owl:Class ;
    rdfs:subClassOf bhv:Achievement ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty dul:satisfies ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf [
                rdf:first folk:Accomplishment ;
                rdf:rest rdf:nil
            ]
        ]
    ] .

folk:Acceptance
    rdf:type folk:FolkValue ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "Our world has billions of people in it–all of whom are somehow unique. Being able to accept people who are completely different from you can help increase the pleasure and enlightenment in your life." ;
    rdfs:label "acceptance" ;
    rdfs:subClassOf folk:Feelings ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty dul:satisfies ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf [
                rdf:first folk:Acceptance ;
                rdf:rest rdf:nil
            ]
        ]
    ] ;
    prov:wasAttributedTo "https://georgetownpsychology.com/inner-values/" ;
    fschema:subsumedUnder folk:Feelings .

