folk:Service
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/inner.owl#InnerValue> ;
    rdf:type <http://www.ontologydesignpatterns.org/ont/values/schwartz.owl#IndividualValue> ;
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdfs:comment "When one of your personal core values is service, you find a sense of fulfillment in sharing your talents or abilities with others in a way that is beneficial to their lives, and you’re willing to contribute to your society without expecting anything in return." ;
    rdfs:label "service" ;
    rdfs:label "service , service to others" ;
    rdfs:subClassOf folk:Spirituality ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty dul:satisfies ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
