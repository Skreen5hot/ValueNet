    rdf:type owl:NamedIndividual ;
    rdf:type bhv:BHV_Value ;
    rdfs:comment "Defining goal: independent thought and action–choosing, creating, exploring." ;
    rdfs:label "self-direction" ;
    rdfs:subClassOf vcvf:ValueSituation ;
    rdfs:subClassOf bhv:OpennessToChange ;
