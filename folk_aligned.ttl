fschema:SynsetFrame
    rdf:type owl:Class ;
    rdfs:subClassOf dul:Description .

fschema:subsumedUnder
    rdf:type owl:ObjectProperty ;
    rdf:type owl:TransitiveProperty ;
    owl:inverseOf fschema:subsumes .

fschema:subsumes
    rdf:type owl:ObjectProperty ;
    rdf:type owl:TransitiveProperty .

<https://w3id.org/framester/wn/wn30/instances/synset-prize-verb-1>
    rdf:type owl:NamedIndividual ;
    rdf:type fschema:SynsetFrame ;
    rdfs:comment "hold dear; \"I prize these old photographs\"" ;
    fschema:subsumedUnder <https://w3id.org/framester/framenet/abox/frame/Judgment> .

<https://w3id.org/framester/wn/wn30/instances/synset-respect-verb-1>
    rdf:type owl:NamedIndividual ;
    rdf:type fschema:SynsetFrame ;
    rdfs:comment "regard highly; think much of; \"I respect his judgement\"; \"We prize his creativity\"" ;
    fschema:subsumedUnder <https://w3id.org/framester/framenet/abox/frame/Judgment> .

<https://w3id.org/framester/wn/wn30/instances/synset-value-noun-1>
    rdf:type owl:NamedIndividual ;
    rdf:type fschema:SynsetFrame ;
    rdfs:comment "a numerical quantity measured or assigned or computed; \"the value assigned was 16 milliseconds\"" ;
    fschema:subsumedUnder <https://w3id.org/framester/framenet/abox/frame/Usefulness> .

<https://w3id.org/framester/wn/wn30/instances/synset-value-noun-2>
    rdf:type owl:NamedIndividual ;
    rdf:type fschema:SynsetFrame ;
    rdfs:comment "the quality (positive or negative) that renders something desirable or valuable; \"the Shakespearean Shylock is of dubious value in the modern world\"" ;
    fschema:subsumedUnder <https://w3id.org/framester/framenet/abox/frame/Differentiation> .

<https://w3id.org/framester/wn/wn30/instances/synset-value-noun-6>
    rdf:type owl:Class ;
    rdf:type owl:NamedIndividual ;
    rdf:type fschema:SynsetFrame ;
    rdfs:comment "an ideal accepted by some individual or group; \"he has old-fashioned values\"" ;
    rdfs:subClassOf fschema:FrameOccurrence ;
    rdfs:subClassOf [
        rdf:type owl:Class ;
        owl:unionOf [
            rdf:first <https://w3id.org/framester/framenet/abox/frame/Awareness> ;
            rdf:rest [
                rdf:first <https://w3id.org/framester/framenet/abox/frame/Judgment> ;
                rdf:rest [
                    rdf:first <https://w3id.org/framester/framenet/abox/frame/Regard> ;
                    rdf:rest rdf:nil
                ]
            ]
        ]
    ] ;
    fschema:subsumedUnder <https://w3id.org/framester/framenet/abox/frame/Awareness> ;
    fschema:subsumedUnder <https://w3id.org/framester/framenet/abox/frame/Judgment> ;
    fschema:subsumedUnder <https://w3id.org/framester/framenet/abox/frame/Regard> .

<https://w3id.org/framester/wn/wn30/instances/synset-value-verb-1>
    rdf:type owl:NamedIndividual ;
    rdf:type fschema:SynsetFrame ;
    rdfs:comment "fix or determine the value of; assign a value to; \"value the jewelry and art work in the estate\"" ;
    fschema:subsumedUnder <https://w3id.org/framester/framenet/abox/frame/Expertise> ;
    fschema:subsumedUnder <https://w3id.org/framester/framenet/abox/frame/Quantity> .

