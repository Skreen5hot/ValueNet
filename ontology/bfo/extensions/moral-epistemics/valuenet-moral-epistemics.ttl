@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix vn-core: <https://fandaws.com/ontology/bfo/valuenet-core#> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics.owl>
  a owl:Ontology ;
  owl:versionIRI <https://fandaws.com/ontology/bfo/1.0/valuenet-moral-epistemics.owl> ;
  owl:imports <https://fandaws.com/ontology/bfo/valuenet-folk.owl>, <https://fandaws.com/ontology/bfo/valuenet-moral-foundations.owl> ;
  dc:title "ValueNet Moral Epistemics Module"@en ;
  dc:description "An ontology of the cognitive acts by which agents assess one another morally: behavioural observation, prudent discernment, rash judgment, and the protective action that discernment can ground."@en ;
  rdfs:label "ValueNet Moral Epistemics"@en ;
  rdfs:comment "Scope note. This module models the structure of moral assessment, not its correctness. The distinction it draws between discernment and rash judgment turns on evidential warrant alone: an assessment is rash when it ascribes interior culpability to an agent without being warranted by observational evidence. That criterion is deliberately tradition-neutral and is asserted in the class axioms. The theological reading of the same distinction (Catechism of the Catholic Church 2477-2478, on rash judgment as an offence against the reputation of persons) motivated the module and is recorded in the definitions as provenance, but is not itself asserted as ontology. Following the suite's practice of keeping Schwartz, Haidt, Curry and folk psychology in separate modules, any further tradition-specific commitments belong in a module of their own, linked by the annotation-only mapping vocabulary declared in valuenet-core."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics> .

#################################################################
#    Object properties
#################################################################

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#hasInformationalInput>
  a owl:ObjectProperty ;
  rdfs:subPropertyOf cco:ont00001921 ;
  rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
  rdfs:range cco:ont00000958 ;
  rdfs:label "has informational input"@en ;
  skos:definition "A relation between a process and an information content entity that is available to that process at its start and on which the process operates."@en ;
  rdfs:comment "Specializes CCO ERO has input (ont00001921) to information-content inputs. The CCO parent is a subproperty of BFO has participant and explicitly permits generically dependent continuants in its range."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#hasInformationalInput> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#hasInformationalOutput>
  a owl:ObjectProperty ;
  rdfs:subPropertyOf cco:ont00001986 ;
  rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
  rdfs:range cco:ont00000958 ;
  rdfs:label "has informational output"@en ;
  skos:definition "A relation between a process and an information content entity that comes to exist, or comes to be borne by some new bearer, as a result of that process."@en ;
  rdfs:comment "Specializes CCO ERO has output (ont00001986) to information-content outputs. The CCO parent is a subproperty of BFO has participant and explicitly permits generically dependent continuants in its range."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#hasInformationalOutput> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#isWarrantedBy>
  a owl:ObjectProperty ;
  rdfs:domain <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#MoralAssessmentICE> ;
  rdfs:range <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#ObservationalEvidenceICE> ;
  rdfs:label "is warranted by"@en ;
  skos:definition "A relation from a moral assessment information content entity to an observational evidence information content entity whose recorded content supports that assessment."@en ;
  rdfs:comment "Warrant is modeled as a relation between information content entities rather than as a quality of an assessment. A BFO quality inheres in an independent continuant, whereas an information content entity is a generically dependent continuant. Missing warrant is evaluated by the closed-world SHACL profile."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#isWarrantedBy> .

#################################################################
#    Realizable entities
#################################################################

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#PrudenceDisposition>
  a owl:Class ;
  rdfs:subClassOf <https://fandaws.com/ontology/bfo/valuenet-core#MoralValueDisposition> ;
  vn-core:hasBroaderConceptualMatch <https://fandaws.com/ontology/bfo/valuenet-folk#WisdomDisposition> ;
  vn-core:hasRelatedConceptualMatch <https://fandaws.com/ontology/bfo/valuenet-folk#DiscretionDisposition>, <https://fandaws.com/ontology/bfo/valuenet-schwartz-values#SecurityDisposition> ;
  skos:definition "A moral value disposition to apply right reason to particular practical judgments, inclining its bearer to assess a situation in proportion to the evidence actually available and to act on that assessment."@en ;
  rdfs:label "Prudence Disposition"@en ;
  skos:altLabel "Prudence"@en ;
  rdfs:comment "Distinguished from folk:WisdomDisposition, which covers the accumulation and application of knowledge generally, and from folk:DiscretionDisposition, which concerns restraint in speech and the handling of private information. Prudence is specifically the fit between the strength of an assessment and the evidence for it."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#PrudenceDisposition> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#ProtectorRole>
  a owl:Class ;
  rdfs:subClassOf <https://fandaws.com/ontology/bfo/valuenet-core#ValueRole> ;
  skos:definition "A value role borne by an agent standing in a relation of guardianship to one or more dependent agents, conferring the normative expectation that the bearer act to preserve their safety and well-being."@en ;
  rdfs:label "Protector Role"@en ;
  skos:altLabel "Protector"@en ;
  skos:example "The role borne by a parent with respect to a child, or by a guardian with respect to a ward."@en ;
  rdfs:comment "Externally grounded, and so a role rather than a disposition: it is conferred by the relationship, and an agent can bear it without any corresponding inclination. The disposition that typically accompanies it is mft:CareDisposition."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#ProtectorRole> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#MoralCulpabilityRole>
  a owl:Class ;
  rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ,
    [ a owl:Restriction ;
      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000197> ;
      owl:someValuesFrom cco:ont00001017
    ] ;
  skos:definition "A role that inheres in an agent because a norm-governed moral appraisal treats that agent as accountable for some conduct, and that can be realized in processes of censure, correction, restitution, forgiveness, or sanction."@en ;
  rdfs:label "Moral Culpability Role"@en ;
  rdfs:comment "An externally grounded normative status, not an intention, consent act, mental state, or information content entity. A culpability ascription does not entail that its target actually bears this role."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#MoralCulpabilityRole> .

#################################################################
#    Information content entities
#
#    The reviewed Phase 5 mappings reuse CCO Descriptive and
#    Prescriptive Information Content Entity as formal parents where
#    every instance satisfies the CCO differentia.
#################################################################

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#ObservationalEvidenceICE>
  a owl:Class ;
  rdfs:subClassOf cco:ont00000853 ;
  skos:definition "A descriptive information content entity that records what was perceptually available to some agent, and that can serve as the evidential basis of a subsequent claim."@en ;
  rdfs:label "Observational Evidence ICE"@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#ObservationalEvidenceICE> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#BehavioralObservationICE>
  a owl:Class ;
  rdfs:subClassOf <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#ObservationalEvidenceICE> ,
    [ a owl:Restriction ;
      owl:onProperty cco:ont00001982 ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#AgentBehaviorProcess>
    ] ;
  skos:definition "Observational evidence that records the behaviour of an agent as perceived by another agent."@en ;
  rdfs:label "Behavioral Observation ICE"@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#BehavioralObservationICE> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#MoralNormICE>
  a owl:Class ;
  rdfs:subClassOf cco:ont00000965 ;
  skos:definition "A prescriptive information content entity that prescribes how agents ought to act, and against which observed behaviour can be assessed."@en ;
  rdfs:label "Moral Norm ICE"@en ;
  skos:example "A rule of a moral code, a professional code of conduct, a household rule."@en ;
  rdfs:comment "A reviewed subclass of CCO Prescriptive Information Content Entity (ont00000965), which carries 'Directive ICE' as an alternative label; no equivalence is asserted because CCO also includes non-moral prescriptions."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#MoralNormICE> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#MoralAssessmentICE>
  a owl:Class ;
  rdfs:subClassOf cco:ont00000853 ;
  skos:definition "A descriptive information content entity that records an evaluative claim about an agent or the agent's conduct under a moral norm."@en ;
  rdfs:label "Moral Assessment ICE"@en ;
  rdfs:comment "The output of a moral-assessment act. Its existence is distinct from the act that produced it, the entity it describes, and whether its claim is warranted or true."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#MoralAssessmentICE> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#WarrantedMoralAssessmentICE>
  a owl:Class ;
  rdfs:subClassOf <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#MoralAssessmentICE> ;
  owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
      <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#MoralAssessmentICE>
      [ a owl:Restriction ;
        owl:onProperty <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#isWarrantedBy> ;
        owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#ObservationalEvidenceICE>
      ]
    )
  ] ;
  skos:definition "A moral assessment information content entity that is warranted by some observational evidence information content entity."@en ;
  rdfs:label "Warranted Moral Assessment ICE"@en ;
  rdfs:comment "A positive open-world classification: an asserted warrant is sufficient for classification. Failure to record a warrant does not entail membership in a complementary class and is checked by SHACL where required."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#WarrantedMoralAssessmentICE> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#SafetyAssessmentICE>
  a owl:Class ;
  rdfs:subClassOf <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#WarrantedMoralAssessmentICE> ,
    [ a owl:Restriction ;
      owl:onProperty <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#isWarrantedBy> ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#BehavioralObservationICE>
    ] ,
    [ a owl:Restriction ;
      owl:onProperty cco:ont00001982 ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#AgentBehaviorProcess>
    ] ;
  skos:definition "A descriptive information content entity that describes the risk an agent's observed conduct poses to some other agent, and that is warranted by observation of that conduct."@en ;
  rdfs:label "Safety Assessment ICE"@en ;
  rdfs:comment "The warrant restriction is what makes this the output of discernment rather than of rash judgment. An assessment of risk that is not warranted by observation is not an instance of this class."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#SafetyAssessmentICE> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#CulpabilityAscriptionICE>
  a owl:Class ;
  rdfs:subClassOf <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#MoralAssessmentICE> ,
    [ a owl:Restriction ;
      owl:onProperty cco:ont00001982 ;
      owl:someValuesFrom cco:ont00001017
    ] ;
  skos:definition "A moral assessment information content entity that describes an agent as bearing moral culpability or another accountability-grounding moral status."@en ;
  rdfs:label "Culpability Ascription ICE"@en ;
  rdfs:comment "The class requires only that the ascription describe an Agent. It does not existentially require a MoralCulpabilityRole: doing so would create a culpability status even for a false or unwarranted ascription. A true ascription may be accompanied by an independently asserted role individual borne by the described agent."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#CulpabilityAscriptionICE> .

#################################################################
#    Processes
#################################################################

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#AgentBehaviorProcess>
  a owl:Class ;
  rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
  skos:definition "A process in which an agent participates as its bearer of action, and which is available to the senses of other agents."@en ;
  rdfs:label "Agent Behavior Process"@en ;
  rdfs:comment "Named for what the process is rather than for our epistemic access to it. An earlier draft called this 'observable agent behaviour'; observability is not a feature of the process but of the relation between the process and a perceiver, and is carried here by ActOfBehavioralObservation instead."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#AgentBehaviorProcess> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#ActOfBehavioralObservation>
  a owl:Class ;
  rdfs:subClassOf cco:ont00000037 ,
    [ a owl:Restriction ;
      owl:onProperty <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#hasInformationalOutput> ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#BehavioralObservationICE>
    ] ;
  skos:definition "An act of observation in which an agent acquires information through perception of another agent's behavior and produces a descriptive record of what was perceived."@en ;
  rdfs:label "Act of Behavioral Observation"@en ;
  rdfs:comment "A reviewed subclass of CCO Act of Observation (ont00000037). The observed AgentBehaviorProcess is not related to this act by has input: CCO has input is a subproperty of has participant and its range excludes processes. The output record instead describes the observed behavior through CCO describes (ont00001982)."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#ActOfBehavioralObservation> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#MoralAssessmentAct>
  a owl:Class ;
  rdfs:subClassOf cco:ont00000636 ,
    [ a owl:Restriction ;
      owl:onProperty <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#hasInformationalOutput> ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#MoralAssessmentICE>
    ] ,
    [ a owl:Restriction ;
      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
      owl:someValuesFrom cco:ont00001017
    ] ;
  skos:definition "An act of appraisal in which an agent evaluates another agent or that agent's conduct under an actual or purported moral standard and produces a moral assessment information content entity."@en ;
  rdfs:label "Moral Assessment Act"@en ;
  rdfs:comment "Common occurrent parent of prudent discernment and rash judgment. The act is distinct from its information-content output and from the agent or conduct that output describes."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#MoralAssessmentAct> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#MoralDiscernmentAct>
  a owl:Class ;
  rdfs:subClassOf <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#MoralAssessmentAct> ,
    <https://fandaws.com/ontology/bfo/valuenet-core#ValueRealizationProcess> ,
    [ a owl:Restriction ;
      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000055> ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#PrudenceDisposition>
    ] ,
    [ a owl:Restriction ;
      owl:onProperty <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#hasInformationalInput> ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#BehavioralObservationICE>
    ] ,
    [ a owl:Restriction ;
      owl:onProperty <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#hasInformationalInput> ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#MoralNormICE>
    ] ,
    [ a owl:Restriction ;
      owl:onProperty <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#hasInformationalOutput> ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#SafetyAssessmentICE>
    ] ,
    [ a owl:Restriction ;
      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000062> ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#ActOfBehavioralObservation>
    ] ;
  skos:definition "An act of appraisal and value realization process in which an agent assesses another agent's observed behaviour against a moral norm and produces an assessment of the risk that behaviour poses, thereby realizing a prudence disposition."@en ;
  rdfs:label "Moral Discernment Act"@en ;
  skos:altLabel "Prudent Assessment"@en ;
  rdfs:comment "A narrower MoralAssessmentAct whose output is a warranted safety assessment and whose process realizes a prudence disposition. No equivalence is asserted because other moral-assessment acts may be warranted without having this risk-assessment structure."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#MoralDiscernmentAct> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#RashJudgmentAct>
  a owl:Class ;
  rdfs:subClassOf <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#MoralAssessmentAct> ,
    <https://fandaws.com/ontology/bfo/valuenet-core#ValueViolationProcess> ,
    [ a owl:Restriction ;
      owl:onProperty <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#hasInformationalOutput> ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#CulpabilityAscriptionICE>
    ] ,
    [ a owl:Restriction ;
      owl:onProperty <https://fandaws.com/ontology/bfo/valuenet-core#contravenes> ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-folk#JusticeDisposition>
    ] ,
    [ a owl:Restriction ;
      owl:onProperty <https://fandaws.com/ontology/bfo/valuenet-core#contravenes> ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-folk#HonestyDisposition>
    ] ,
    [ a owl:Restriction ;
      owl:onProperty <https://fandaws.com/ontology/bfo/valuenet-core#contravenes> ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-foundations#CareDisposition>
    ] ;
  vn-core:hasRelatedConceptualMatch <https://w3id.org/spice/SON/HaidtValues#Cheating>, <https://w3id.org/spice/SON/HaidtValues#Harm> ;
  skos:definition "A moral assessment act and value violation process in which an agent produces an ascription of moral culpability to another agent that is not warranted by observational evidence."@en ;
  rdfs:label "Rash Judgment Act"@en ;
  skos:altLabel "Rash Judgment"@en ;
  rdfs:comment "The defect is located in the warrant relation on the act's culpability-ascription output, not in a supposed interior-state entity. OWL asserts the positive output type; the annotation profile uses SHACL to require that a recorded RashJudgmentAct have at least one culpability-ascription output with no recorded warrant."@en ,
    "RashJudgmentAct is not disjoint with MoralDiscernmentAct. One larger or temporally extended moral-assessment act can produce both a warranted safety assessment and an unwarranted culpability ascription; class disjointness would incorrectly make that mixed process inconsistent."@en ,
    "Motivating source: Catechism of the Catholic Church 2477-2478, on rash judgment as an offence against the reputation of persons. Recorded as provenance; the axioms above assert only the evidential criterion."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#RashJudgmentAct> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#MixedMoralAssessmentAct>
  a owl:Class ;
  rdfs:subClassOf <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#MoralDiscernmentAct> ,
    <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#RashJudgmentAct> ;
  skos:definition "A moral assessment act that satisfies the discernment pattern while also producing an unwarranted culpability ascription that satisfies the rash-judgment annotation criterion."@en ;
  rdfs:label "Mixed Moral Assessment Act"@en ;
  rdfs:comment "This named overlap class makes the rejected disjointness testable: it must remain satisfiable. It represents a larger or temporally extended act with both warranted and unwarranted assessment outputs."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#MixedMoralAssessmentAct> .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#ProtectiveAction>
  a owl:Class ;
  rdfs:subClassOf <https://fandaws.com/ontology/bfo/valuenet-core#ValueRealizationProcess> ,
    [ a owl:Restriction ;
      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000055> ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#ProtectorRole>
    ] ,
    [ a owl:Restriction ;
      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000055> ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-foundations#CareDisposition>
    ] ,
    [ a owl:Restriction ;
      owl:onProperty <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#hasInformationalInput> ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#SafetyAssessmentICE>
    ] ,
    [ a owl:Restriction ;
      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000062> ;
      owl:someValuesFrom <https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#MoralDiscernmentAct>
    ] ;
  vn-core:hasRelatedConceptualMatch <https://w3id.org/spice/SON/HaidtValues#Care> ;
  skos:definition "A value realization process in which an agent bearing a protector role acts on a safety assessment in order to reduce the risk of harm to a dependent agent, thereby realizing that role together with a care disposition."@en ;
  rdfs:label "Protective Action"@en ;
  rdfs:comment "The dependence on prior discernment is asserted with bfo:preceded by rather than left implicit in the shared assessment, so that the causal chain from behaviour through observation and discernment to action is queryable end to end."@en ;
  rdfs:seeAlso <https://w3id.org/valuenet/moral-epistemics#ProtectiveAction> .

#################################################################
#    Agent participation
#
#    Every act modeled here is performed by an agent.
#    PrudenceDisposition and ProtectorRole need no axiom of their
#    own: they inherit "inheres in some Agent" from
#    vn-core:ValueRelatedRealizableEntity.
#################################################################

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#AgentBehaviorProcess>
  rdfs:subClassOf [ a owl:Restriction ;
    owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
    owl:someValuesFrom <https://www.commoncoreontologies.org/ont00001017> ] .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#ActOfBehavioralObservation>
  rdfs:subClassOf [ a owl:Restriction ;
    owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
    owl:someValuesFrom <https://www.commoncoreontologies.org/ont00001017> ] .

<https://fandaws.com/ontology/bfo/valuenet-moral-epistemics#ProtectiveAction>
  rdfs:subClassOf [ a owl:Restriction ;
    owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
    owl:someValuesFrom <https://www.commoncoreontologies.org/ont00001017> ] .
