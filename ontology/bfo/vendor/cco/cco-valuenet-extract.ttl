ns1:ont00000345 a owl:Class ;
    rdfs:label "Act of Measuring"@en ;
    rdfs:subClassOf ns1:ont00000228 ;
    skos:definition "A Planned Act that involves determining the extent, dimensions, quanity, or quality of an Entity relative to some standard."@en ;
    skos:example "putting an object on a scale to measure its weight in kilograms",
        "rating Hollywood movies on a 1 to 5 star scale",
        "using a tape measure to determine the height and width of a doorway in inches" ;
    ns1:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

ns1:ont00001379 a owl:Class ;
    rdfs:label "Agent Capability"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ;
    skos:definition "A Realizable Entity that inheres in a Material Entity in virtue of that Material Entity's capacity to realize it in some Planned Act."@en ;
    ns1:ont00001754 "Schlosser, Markus, \"Agency\", The Stanford Encyclopedia of Philosophy (Winter 2019 Edition), Edward N. Zalta (ed.), available at: https://plato.stanford.edu/archives/win2019/entries/agency/"@en ;
    ns1:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

ns1:ont00001921 a owl:ObjectProperty ;
    rdfs:label "has input"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.obolibrary.org/obo/BFO_0000020> <http://purl.obolibrary.org/obo/BFO_0000031> [ a owl:Class ;
                        owl:intersectionOf ( <http://purl.obolibrary.org/obo/BFO_0000004> [ a owl:Class ;
                                    owl:complementOf <http://purl.obolibrary.org/obo/BFO_0000006> ] ) ] ) ] ;
    rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000057> ;
    skos:definition "x has input y =Def y is input of x."@en ;
    ns1:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

ns1:ont00001986 a owl:ObjectProperty ;
    rdfs:label "has output"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.obolibrary.org/obo/BFO_0000020> <http://purl.obolibrary.org/obo/BFO_0000031> [ a owl:Class ;
                        owl:intersectionOf ( <http://purl.obolibrary.org/obo/BFO_0000004> [ a owl:Class ;
                                    owl:complementOf <http://purl.obolibrary.org/obo/BFO_0000006> ] ) ] ) ] ;
    rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000057> ;
    skos:definition "x has output y =Def y is output of x."@en ;
    ns1:ont00001754 "https://en.wikipedia.org/w/index.php?title=IPO_model&oldid=1024398398"^^xsd:anyURI ;
    ns1:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

