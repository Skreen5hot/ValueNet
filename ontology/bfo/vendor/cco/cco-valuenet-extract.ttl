ns1:ont00000005 a owl:Class ;
    rdfs:label "Act"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "A Process in which at least one Agent plays a causative role."@en ;
    ns1:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

ns1:ont00000228 a owl:Class ;
    rdfs:label "Planned Act"@en ;
    rdfs:subClassOf ns1:ont00000005 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:ont00000005 [ a owl:Restriction ;
                        owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000055> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Class ;
                                            owl:unionOf ( <http://purl.obolibrary.org/obo/BFO_0000016> <http://purl.obolibrary.org/obo/BFO_0000023> ) ] [ a owl:Restriction ;
                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000059> ;
                                            owl:someValuesFrom ns1:ont00000965 ] ) ] ] ) ] ;
    skos:altLabel "Intentional Act"@en ;
    skos:definition "An Act in which at least one Agent plays a causative role and which is prescribed by some Directive Information Content Entity held by at least one of the Agents."@en ;
    ns1:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

ns1:ont00000853 a owl:Class ;
    rdfs:label "Descriptive Information Content Entity"@en ;
    rdfs:subClassOf ns1:ont00000958 ;
    owl:disjointWith ns1:ont00000965 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:ont00000958 [ a owl:Restriction ;
                        owl:onProperty ns1:ont00001982 ;
                        owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000001> ] ) ] ;
    skos:altLabel "Descriptive ICE"@en ;
    skos:definition "An Information Content Entity that describes some Entity."@en ;
    ns1:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

ns1:ont00001801 a owl:ObjectProperty ;
    rdfs:label "is subject of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000001> ;
    rdfs:range ns1:ont00000958 ;
    owl:inverseOf ns1:ont00001808 ;
    skos:definition "x is subject of y =Def y is about x."@en ;
    ns1:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

ns1:ont00001942 a owl:ObjectProperty ;
    rdfs:label "prescribes"@en ;
    rdfs:domain ns1:ont00000965 ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
    rdfs:subPropertyOf ns1:ont00001808 ;
    skos:definition "x prescribes y iff x is an instance of Information Content Entity and y is an instance of Entity, such that x serves as a rule or guide for y if y an Occurrent, or x serves as a model for y if y is a Continuant."@en ;
    skos:example "A blueprint prescribes some artifact or facility by being a model for it.",
        "A professional code of conduct prescribes some realizations of a profession (role) by giving rules for how the bearer should act in those realizations.",
        "An operations plan prescribes an operation by enumerating the tasks that need to be performed in order to achieve the objectives of the operation." ;
    ns1:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

ns1:ont00001982 a owl:ObjectProperty ;
    rdfs:label "describes"@en ;
    rdfs:domain ns1:ont00000853 ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
    rdfs:subPropertyOf ns1:ont00001808 ;
    skos:definition "x describes y iff x is an instance of Descriptive Information Content Entity, and y is an instance of Entity, such that x is_about the characteristics that identify y."@en ;
    skos:example "the content of a newspaper article describes some current event",
        "the content of a visitor's log describes some facility visit",
        "the content of an accident report describes some accident" ;
    skos:scopeNote "It is possible that this relation should be a functional property, that is for all x, y, z if x describes y and x describes z then y = z. For example, if a financial report x describes the quarterly results of a company y and that same financial report describes the quarterly results of a company z, then it should be inferred that companies y and z are the same. We refrained from classifying the relation as a functional property on the concern that descriptions are multifaceted and so consequently it may be that the same report would contain descriptions of multiple entities."@en ;
    ns1:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

<http://purl.obolibrary.org/obo/BFO_0000004> a owl:Class .

<http://purl.obolibrary.org/obo/BFO_0000006> a owl:Class .

<http://purl.obolibrary.org/obo/BFO_0000020> a owl:Class .

ns1:ont00000965 a owl:Class ;
    rdfs:label "Prescriptive Information Content Entity"@en ;
    rdfs:subClassOf ns1:ont00000958 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:ont00000958 [ a owl:Restriction ;
                        owl:onProperty ns1:ont00001942 ;
                        owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000001> ] ) ] ;
    skos:altLabel "Directive ICE"@en ;
    skos:definition "An Information Content Entity that prescribes some Entity."@en ;
    ns1:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

ns1:ont00001808 a owl:ObjectProperty ;
    rdfs:label "is about"@en ;
    rdfs:domain ns1:ont00000958 ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:definition "x is_about y is a primitive relationship between an instance of Information Content Entity x and an instance of Entity y."@en ;
    ns1:ont00001754 "http://purl.obolibrary.org/obo/IAO_0000136" ;
    ns1:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

<http://purl.obolibrary.org/obo/BFO_0000015> a owl:Class .

<http://purl.obolibrary.org/obo/BFO_0000031> a owl:Class .

ns1:ont00000958 a owl:Class ;
    rdfs:label "Information Content Entity"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.obolibrary.org/obo/BFO_0000031> [ a owl:Restriction ;
                        owl:onProperty ns1:ont00001808 ;
                        owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000001> ] ) ] ;
    skos:altLabel "ICE"@en ;
    skos:definition "A Generically Dependent Continuant that generically depends on some Information Bearing Entity and stands in relation of aboutness to some Entity."@en ;
    skos:scopeNote "Information Content Entity is here intended to be a class of Entities whose instances are the informational content of Information Bearing Entities. For example, three instances of information bearers -- such as a bar chart, color-coded map, and a written report -- each of which lists the GDP of Countries for the year 2010 are each different carriers of the same information content. It is this content that is generically dependent upon its carrier. This treatment of Informational Content Entity (cf. the Information Artifact Ontology) leads to a principle of subtyping based upon the relationship that ICE's have with the Entity they are about rather than characteristics such as format, language, measurement scale, or media. The latter are treated here as being Qualities of bearers."@en ;
    ns1:ont00001754 "http://purl.obolibrary.org/obo/IAO_0000030" ;
    ns1:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

<http://purl.obolibrary.org/obo/BFO_0000001> a owl:Class .

