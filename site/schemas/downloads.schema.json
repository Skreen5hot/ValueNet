{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skreen5hot.github.io/ValueNet/schemas/downloads.schema.json",
  "title": "BFO-Aligned ValueNet download manifest",
  "description": "Every published Turtle file with its size, checksum, namespace and provenance, plus the deterministic bundle and the two checksum records. The machine-readable form of the downloads page.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "generated_by",
    "source_commit",
    "modules",
    "governance",
    "bundle",
    "checksums",
    "note"
  ],
  "properties": {
    "format_version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "note": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "group",
          "source",
          "filename",
          "bytes",
          "sha256",
          "ontology_iri",
          "namespace",
          "own_terms",
          "title",
          "description",
          "license",
          "licence_category",
          "spdx",
          "indexed",
          "source_commit",
          "imports",
          "references"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "enum": [
              "primary",
              "supporting"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^ontology/.+\\.ttl$"
          },
          "filename": {
            "type": "string",
            "pattern": "^[^/]+\\.ttl$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "ontology_iri": {
            "type": "string",
            "format": "uri"
          },
          "namespace": {
            "type": "string",
            "format": "uri"
          },
          "own_terms": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "format": "uri"
          },
          "licence_category": {
            "enum": [
              "project-content"
            ]
          },
          "spdx": {
            "type": "string",
            "minLength": 1
          },
          "indexed": {
            "type": "boolean"
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "imports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "governance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filename",
          "bytes",
          "sha256"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "root",
        "bytes",
        "sha256",
        "members"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[^/]+\\.zip$"
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "published",
        "in_bundle"
      ],
      "properties": {
        "published": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "covers",
            "note"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "covers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "note": {
              "type": "string"
            }
          }
        },
        "in_bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "covers",
            "note"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "covers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
