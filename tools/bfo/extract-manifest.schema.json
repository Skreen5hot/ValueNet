{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fandaws.com/schema/bfo-remediation/extract-manifest.schema.json",
  "title": "ValueNet ontology extract manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extract_id",
    "source_project",
    "source_release",
    "source_commit",
    "source_artifact_url",
    "source_sha256",
    "retrieved_on",
    "license",
    "root_terms",
    "closure_policy",
    "generated_by",
    "extract_sha256",
    "modifications",
    "extract_canonical_sha256"
  ],
  "properties": {
    "extract_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "source_project": {
      "type": "string",
      "enum": [
        "CCO",
        "RO",
        "IAO",
        "SKOS",
        "OTHER"
      ]
    },
    "source_release": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_artifact_url": {
      "type": "string",
      "format": "uri"
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "retrieved_on": {
      "type": "string",
      "format": "date"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "url",
        "attribution_required"
      ],
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "attribution_required": {
          "type": "boolean"
        }
      }
    },
    "root_terms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "closure_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declarations",
        "annotations",
        "logical_axioms",
        "referenced_entities",
        "import_declarations"
      ],
      "properties": {
        "declarations": {
          "type": "boolean",
          "const": true
        },
        "annotations": {
          "type": "boolean"
        },
        "logical_axioms": {
          "type": "boolean",
          "const": true
        },
        "referenced_entities": {
          "type": "string",
          "enum": [
            "recursive",
            "declared-only",
            "none"
          ]
        },
        "import_declarations": {
          "type": "string",
          "enum": [
            "preserve",
            "rewrite-pinned",
            "omit-documented"
          ]
        }
      }
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "version"
      ],
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "modifications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extract_canonical_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "Digest of the extract's canonical RDF, which line endings do not affect. The provenance refresh guards on this rather than on extract_sha256, so that normalizing line endings is permitted and a genuinely different extract is not."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
